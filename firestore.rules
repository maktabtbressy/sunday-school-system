rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function userDocExists() { return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function myDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function myRole() { return userDocExists() ? myDoc().data.role : null; }
    function myChurch() { return userDocExists() ? myDoc().data.churchId : null; }
    function isSuperAdmin() { return isSignedIn() && myRole() == 'superadmin'; }
    function isChurchAdmin() { return isSignedIn() && myRole() == 'admin'; }
    function belongsToChurch(chId) { return isSignedIn() && myChurch() == chId; }

    // ===== الكنايس (المستأجرين): قراءة عامة لأي مستخدم مسجّل (بيانات غير حساسة) =====
    match /churches/{chId} {
      allow read: if isSignedIn();
      // إنشاء كنيسة جديدة بيحصل وقت التسجيل الذاتي لمسؤول كنيسة جديدة
      allow create: if isSignedIn();
      // تعديل حالة الاشتراك/التفعيل مسموح للمالك بس (حماية من إن حد يفعّل نفسه بنفسه)
      allow update, delete: if isSuperAdmin();
    }

    // ===== المستخدمون وأدوارهم =====
    match /users/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        isSuperAdmin() ||
        (isChurchAdmin() && resource.data.churchId == myChurch())
      );
      // إنشاء حساب جديد (تسجيل ذاتي لأول مرة) بيعمله الشخص لنفسه بس
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update, delete: if isSuperAdmin() ||
        (isChurchAdmin() && resource.data.churchId == myChurch());
    }

    // ===== إعدادات كل كنيسة (مستند واحد لكل كنيسة، معرّفه = رقم الكنيسة) =====
    match /settings/{chId} {
      allow read, write: if isSignedIn() && (isSuperAdmin() || belongsToChurch(chId));
    }

    // ===== سجل العمليات: إضافة فقط، بدون تعديل أو حذف =====
    match /auditLog/{docId} {
      allow read: if isSignedIn() && (isSuperAdmin() || belongsToChurch(resource.data.churchId));
      allow create: if isSignedIn() && (isSuperAdmin() || request.resource.data.churchId == myChurch());
      allow update, delete: if false;
    }

    // ===== بيانات كل كنيسة (كل سجل معلّم برقم كنيسته) =====
    match /members/{docId} {
      allow read, update, delete: if isSignedIn() && (isSuperAdmin() || belongsToChurch(resource.data.churchId));
      allow create: if isSignedIn() && (isSuperAdmin() || request.resource.data.churchId == myChurch());
    }
    match /servants/{docId} {
      allow read, update, delete: if isSignedIn() && (isSuperAdmin() || belongsToChurch(resource.data.churchId));
      allow create: if isSignedIn() && (isSuperAdmin() || request.resource.data.churchId == myChurch());
    }
    match /stages/{docId} {
      allow read, update, delete: if isSignedIn() && (isSuperAdmin() || belongsToChurch(resource.data.churchId));
      allow create: if isSignedIn() && (isSuperAdmin() || request.resource.data.churchId == myChurch());
    }
    match /grades/{docId} {
      allow read, update, delete: if isSignedIn() && (isSuperAdmin() || belongsToChurch(resource.data.churchId));
      allow create: if isSignedIn() && (isSuperAdmin() || request.resource.data.churchId == myChurch());
    }
    match /classes/{docId} {
      allow read, update, delete: if isSignedIn() && (isSuperAdmin() || belongsToChurch(resource.data.churchId));
      allow create: if isSignedIn() && (isSuperAdmin() || request.resource.data.churchId == myChurch());
    }
    match /attendance/{docId} {
      allow read, update, delete: if isSignedIn() && (isSuperAdmin() || belongsToChurch(resource.data.churchId));
      allow create: if isSignedIn() && (isSuperAdmin() || request.resource.data.churchId == myChurch());
    }
    match /evaluations/{docId} {
      allow read, update, delete: if isSignedIn() && (isSuperAdmin() || belongsToChurch(resource.data.churchId));
      allow create: if isSignedIn() && (isSuperAdmin() || request.resource.data.churchId == myChurch());
    }
    match /followups/{docId} {
      allow read, update, delete: if isSignedIn() && (isSuperAdmin() || belongsToChurch(resource.data.churchId));
      allow create: if isSignedIn() && (isSuperAdmin() || request.resource.data.churchId == myChurch());
    }
    match /activities/{docId} {
      allow read, update, delete: if isSignedIn() && (isSuperAdmin() || belongsToChurch(resource.data.churchId));
      allow create: if isSignedIn() && (isSuperAdmin() || request.resource.data.churchId == myChurch());
    }

    // ===== طرق الدفع (عامة للإدارة، تُعرض على كل الكنايس) =====
    // ===== دعوات المستخدمين (مدير الكنيسة يدعو خدام/مستخدمين جدد بالبريد) =====
    match /invites/{emailId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isSuperAdmin() || (isChurchAdmin() && request.resource.data.churchId == myChurch()));
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && (isSuperAdmin() || isChurchAdmin());
    }

    match /paymentMethods/{docId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // ===== إثباتات الدفع المرسلة من كل كنيسة =====
    match /paymentProofs/{docId} {
      allow read: if isSignedIn() && (isSuperAdmin() || belongsToChurch(resource.data.churchId));
      allow create: if isSignedIn() && (isSuperAdmin() || request.resource.data.churchId == myChurch());
      allow update, delete: if isSuperAdmin();
    }

    // ===== الدردشة بين كل كنيسة والمالك =====
    match /chatMessages/{docId} {
      allow read: if isSignedIn() && (isSuperAdmin() || belongsToChurch(resource.data.churchId));
      allow create: if isSignedIn() && (isSuperAdmin() || request.resource.data.churchId == myChurch());
      allow update, delete: if false;
    }
  }
}
